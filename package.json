{
  "name": "cgs-agent-shell",
  "version": "2.0.0",
  "description": "Causal Growth Science — multi-tenant AI agent platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/queue/worker.ts",
    "eval": "tsx src/evals/runner.ts",
    "db:migrate": "tsx db/migrate.ts",
    "onboard": "tsx src/cli/onboard.ts",
    "onboard:creds": "tsx src/cli/onboardCredentials.ts",
    "setup:cgs": "tsx src/cli/setupCgsCredentials.ts",
    "creds:check": "tsx src/cli/checkCredentials.ts",
    "tenant:list": "tsx src/cli/listTenants.ts",
    "typecheck": "tsc --noEmit",
    "smoke:blocks": "tsx scripts/smoke-blocks-render.ts",
    "smoke:memory": "tsx scripts/smoke-memory-context.ts",
    "test": "vitest run",
    "crawl": "tsx src/cli/crawl.ts",
    "smoke:crawler": "tsx scripts/smoke-crawler-parser.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@google-analytics/data": "^5.2.2",
    "@google-cloud/secret-manager": "^5.6.0",
    "@slack/bolt": "^3.21.0",
    "bullmq": "^5.7.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "framer-api": "^0.1.9",
    "google-auth-library": "^10.6.2",
    "googleapis": "^140.0.1",
    "ioredis": "^5.3.2",
    "langfuse": "^3.30.0",
    "pg": "^8.11.5",
    "robots-parser": "^3.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  }
}